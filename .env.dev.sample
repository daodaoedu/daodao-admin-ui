# vite preview proxy 目標（daodao-ai-backend 在 dev-daodao-network 上的 alias）
BACKEND_URL=http://backend-dev:8000
# vite preview proxy 目標（daodao-server 在 dev-daodao-network 上的 alias）
SERVER_BACKEND_URL=http://dev_app:3000
# 前端 app 問卷填寫頁 base URL：僅本機 pnpm dev／build 生效；部署環境依 admin 主機判定（src/config.ts），容器 runtime 讀不到 VITE_*
VITE_SURVEY_PUBLIC_BASE=https://app-dev.daodao.so/survey/r
# 本機預覽模式（選用）：設為 true 時略過登入並使用前端 mock 資料（email 模板／dashboard／共同挑戰），僅 dev build 生效
# VITE_USE_PREVIEW_MOCK=true
